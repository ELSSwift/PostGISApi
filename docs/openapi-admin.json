              "type": "string"
            }
          },
          "writeRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adminRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultRoles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Roles every valid token gets, e.g. [\"read\"]."
          }
        }
      },
      "QueryParameterConfig": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
