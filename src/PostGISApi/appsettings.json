{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PostGISApi": {
    // Directory with connections.json, layers.json, queries.json, security.json, settings.json
    "ConfigDirectory": "config",
    // Optional admin key (better: environment variable PostGISApi__AdminApiKey)
    "AdminApiKey": "",
    // true behind a reverse proxy that sets X-Forwarded-* headers
    "TrustForwardedHeaders": false
  }
}
